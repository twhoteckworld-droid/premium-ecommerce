<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | NovaStore Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/admin/css/admin.css">
    <link rel="stylesheet" href="/admin/css/products.css">
    <link rel="stylesheet" href="/admin/css/categories.css">
    <link rel="stylesheet" href="/admin/css/orders.css">
    <link rel="stylesheet" href="/admin/css/customers.css">
    <link rel="stylesheet" href="/admin/css/payments.css">
    <link rel="stylesheet" href="/admin/css/coupons.css">
    <link rel="stylesheet" href="/admin/css/inventory.css">
    <link rel="stylesheet" href="/admin/css/reviews.css">
    <link rel="stylesheet" href="/admin/css/settings.css">
    <link rel="stylesheet" href="/admin/css/notifications.css">
    <link rel="stylesheet" href="/admin/css/coupons.css">
    <link rel="stylesheet" href="/admin/css/inventory.css">
    <link rel="stylesheet" href="/admin/css/reviews.css">
    <link rel="stylesheet" href="/admin/css/settings.css">
    <link rel="stylesheet" href="/admin/css/notifications.css">
</head>
<body>

    <div class="admin-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">NOVA<span>STORE</span></div>
                <button class="sidebar-close-btn" id="sidebarClose">✕</button>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Overview</div>
                    <a class="nav-item active" data-view="dashboard" href="#dashboard">
                        <span class="nav-icon">▦</span>
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Catalog</div>
                    <a class="nav-item" data-view="products" href="#products">
                        <span class="nav-icon">📦</span>
                        <span>Products</span>
                    </a>
                    <a class="nav-item" data-view="categories" href="#categories">
                        <span class="nav-icon">🗂️</span>
                        <span>Categories</span>
                    </a>
                    <a class="nav-item" data-view="inventory" href="#inventory">
                        <span class="nav-icon">📊</span>
                        <span>Inventory</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Sales</div>
                    <a class="nav-item" data-view="orders" href="#orders">
                        <span class="nav-icon">🧾</span>
                        <span>Orders</span>
                    </a>
                    <a class="nav-item" data-view="payments" href="#payments">
                        <span class="nav-icon">💳</span>
                        <span>Payments</span>
                    </a>
                    <a class="nav-item" data-view="customers" href="#customers">
                        <span class="nav-icon">👥</span>
                        <span>Customers</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Marketing</div>
                    <a class="nav-item" data-view="coupons" href="#coupons">
                        <span class="nav-icon">🏷️</span>
                        <span>Coupons</span>
                    </a>
                    <a class="nav-item" data-view="reviews" href="#reviews">
                        <span class="nav-icon">⭐</span>
                        <span>Reviews</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Store</div>
                    <a class="nav-item" data-view="settings" href="#settings">
                        <span class="nav-icon">⚙️</span>
                        <span>Settings</span>
                    </a>
                </div>
            </nav>
        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <div class="topbar-left">
                    <button class="menu-toggle" id="menuToggle">☰</button>
                    <div class="page-title" id="pageTitle">Dashboard</div>
                </div>

                <div class="topbar-right">
                    <div style="position:relative;">
                        <button class="topbar-btn" id="notifBell" title="Notifications">
                            🔔
                            <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-dropdown-header">
                                <strong>Notifications</strong>
                                <button id="notifMarkAllRead" style="background:none;border:none;color:var(--blue-bright);font-size:11px;cursor:pointer;font-weight:600;">Mark all read</button>
                            </div>
                            <div class="notif-dropdown-body" id="notifList">
                                <p class="loading-text" style="padding:20px;">Loading...</p>
                            </div>
                        </div>
                    </div>
                    <div class="admin-profile" title="Logged in">
                        <div class="profile-avatar" id="adminAvatar">AD</div>
                        <div class="profile-name" id="adminName">Admin</div>
                    </div>
                    <button class="topbar-btn" id="logoutBtn" title="Logout" style="color:#ef4444;border-color:rgba(239,68,68,0.3);">⏻</button>
                </div>
            </header>

            <main class="admin-content">

                <!-- DASHBOARD VIEW -->
                <div class="view active" id="view-dashboard">
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(45,140,255,0.15);color:#2d8cff;">₹</div>
                            <div class="stat-info">
                                <div class="stat-label">Total Revenue</div>
                                <div class="stat-value" id="statRevenue">₹0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#10b981;">🧾</div>
                            <div class="stat-info">
                                <div class="stat-label">Total Orders</div>
                                <div class="stat-value" id="statOrders">0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#f59e0b;">📦</div>
                            <div class="stat-info">
                                <div class="stat-label">Products</div>
                                <div class="stat-value" id="statProducts">0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(168,85,247,0.15);color:#a855f7;">👥</div>
                            <div class="stat-info">
                                <div class="stat-label">Customers</div>
                                <div class="stat-value" id="statCustomers">0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(239,68,68,0.15);color:#ef4444;">⏳</div>
                            <div class="stat-info">
                                <div class="stat-label">Pending Orders</div>
                                <div class="stat-value" id="statPending">0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#10b981;">✅</div>
                            <div class="stat-info">
                                <div class="stat-label">Delivered</div>
                                <div class="stat-value" id="statDelivered">0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(107,114,128,0.15);color:#9ca3af;">✕</div>
                            <div class="stat-info">
                                <div class="stat-label">Cancelled</div>
                                <div class="stat-value" id="statCancelled">0</div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#f59e0b;">⚠️</div>
                            <div class="stat-info">
                                <div class="stat-label">Low Stock</div>
                                <div class="stat-value" id="statLowStock">0</div>
                            </div>
                        </div>
                    </div>

                    <div class="charts-row">
                        <div class="chart-card">
                            <div class="chart-header"><h3>Daily Sales (Last 7 Days)</h3></div>
                            <div class="chart-body"><canvas id="dailyChart"></canvas></div>
                        </div>
                        <div class="chart-card">
                            <div class="chart-header"><h3>Order Status Distribution</h3></div>
                            <div class="chart-body"><canvas id="statusChart"></canvas></div>
                        </div>
                    </div>

                    <div class="charts-row">
                        <div class="chart-card">
                            <div class="chart-header"><h3>Monthly Revenue (Last 12 Months)</h3></div>
                            <div class="chart-body"><canvas id="monthlyChart"></canvas></div>
                        </div>
                        <div class="chart-card">
                            <div class="chart-header"><h3>Top 5 Products</h3></div>
                            <div class="chart-body"><canvas id="topProductsChart"></canvas></div>
                        </div>
                    </div>

                    <div class="recent-row">
                        <div class="recent-card">
                            <div class="chart-header"><h3>Recent Orders</h3></div>
                            <div class="recent-list" id="recentOrders"><p class="loading-text">Loading...</p></div>
                        </div>
                        <div class="recent-card">
                            <div class="chart-header"><h3>Recent Customers</h3></div>
                            <div class="recent-list" id="recentCustomers"><p class="loading-text">Loading...</p></div>
                        </div>
                        <div class="recent-card">
                            <div class="chart-header"><h3>Low Stock Alerts</h3></div>
                            <div class="recent-list" id="recentLowStock"><p class="loading-text">Loading...</p></div>
                        </div>
                    </div>
                </div>

                <!-- PRODUCTS VIEW -->
                <div class="view" id="view-products">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Products</h2>
                            <p class="view-subtitle">Manage your product catalog</p>
                        </div>
                        <button class="btn-primary btn-add" id="btnAddProduct">+ Add Product</button>
                    </div>

                    <!-- Filters Bar -->
                    <div class="filters-bar">
                        <input type="search" id="productSearch" class="filter-input" placeholder="Search name, SKU, slug...">
                        <select id="productFilterStatus" class="filter-select">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                        <select id="productFilterFeatured" class="filter-select">
                            <option value="">All Products</option>
                            <option value="true">Featured Only</option>
                        </select>
                        <button class="filter-btn" id="btnApplyFilters">Search</button>
                    </div>

                    <!-- Table -->
                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="productsTable">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>SKU</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="productsTableBody">
                                    <tr><td colspan="7" class="table-loading">Loading products...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="productsCount" class="table-info">—</div>
                            <div class="pagination" id="productsPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- CATEGORIES VIEW -->
                <div class="view" id="view-categories">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Categories</h2>
                            <p class="view-subtitle">Organize your product catalog</p>
                        </div>
                        <button class="btn-primary btn-add" id="btnAddCategory">+ Add Category</button>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="categorySearch" class="filter-input" placeholder="Search category name...">
                        <select id="categoryFilterStatus" class="filter-select">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                        <button class="filter-btn" id="btnApplyCategoryFilters">Search</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="categoriesTable">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th>Slug</th>
                                        <th>Products</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="categoriesTableBody">
                                    <tr><td colspan="5" class="table-loading">Loading categories...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="categoriesCount" class="table-info">—</div>
                        </div>
                    </div>
                </div>

                <!-- ORDERS VIEW -->
                <div class="view" id="view-orders">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Orders</h2>
                            <p class="view-subtitle">Track and manage all customer orders</p>
                        </div>
                        <button class="filter-btn" onclick="window.novaOrders.refresh()">🔄 Refresh</button>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="orderSearch" class="filter-input" placeholder="Search order#, customer, phone...">
                        <select id="orderFilterStatus" class="filter-select">
                            <option value="">All Status</option>
                            <option value="Payment Pending">Payment Pending</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Processing">Processing</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Out for Delivery">Out for Delivery</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <input type="date" id="orderFilterFrom" class="filter-select" title="From date">
                        <input type="date" id="orderFilterTo" class="filter-select" title="To date">
                        <button class="filter-btn" id="btnApplyOrderFilters">Filter</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="ordersTable">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Customer</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Payment</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="ordersTableBody">
                                    <tr><td colspan="8" class="table-loading">Loading orders...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="ordersCount" class="table-info">—</div>
                            <div class="pagination" id="ordersPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- CUSTOMERS VIEW -->
                <div class="view" id="view-customers">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Customers</h2>
                            <p class="view-subtitle">Registered customers and their purchase history</p>
                        </div>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="customerSearch" class="filter-input" placeholder="Search name, email, phone...">
                        <button class="filter-btn" id="btnApplyCustomerFilters">Search</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="customersTable">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Phone</th>
                                        <th>Orders</th>
                                        <th>Total Spent</th>
                                        <th>Joined</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="customersTableBody">
                                    <tr><td colspan="6" class="table-loading">Loading customers...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="customersCount" class="table-info">—</div>
                            <div class="pagination" id="customersPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- PAYMENTS VIEW -->
                <div class="view" id="view-payments">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Payments</h2>
                            <p class="view-subtitle">Track all payment transactions</p>
                        </div>
                        <button class="filter-btn" onclick="window.novaPayments.refresh()">🔄 Refresh</button>
                    </div>

                    <div class="payment-stats" id="paymentStats">
                        <div class="pay-stat-card">
                            <div class="pay-stat-label">Total Payments</div>
                            <div class="pay-stat-value" id="statPayTotal">0</div>
                        </div>
                        <div class="pay-stat-card green">
                            <div class="pay-stat-label">Successful</div>
                            <div class="pay-stat-value" id="statPaySuccess">0</div>
                        </div>
                        <div class="pay-stat-card amber">
                            <div class="pay-stat-label">Pending</div>
                            <div class="pay-stat-value" id="statPayPending">0</div>
                        </div>
                        <div class="pay-stat-card red">
                            <div class="pay-stat-label">Failed</div>
                            <div class="pay-stat-value" id="statPayFailed">0</div>
                        </div>
                        <div class="pay-stat-card gray">
                            <div class="pay-stat-label">Refunded</div>
                            <div class="pay-stat-value" id="statPayRefunded">0</div>
                        </div>
                        <div class="pay-stat-card blue">
                            <div class="pay-stat-label">Total Collected</div>
                            <div class="pay-stat-value" id="statPayCollected">₹0</div>
                        </div>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="paymentSearch" class="filter-input" placeholder="Search order#, payment ID...">
                        <select id="paymentFilterStatus" class="filter-select">
                            <option value="">All Status</option>
                            <option value="Verified">Verified</option>
                            <option value="Created">Created / Pending</option>
                            <option value="Failed">Failed</option>
                        </select>
                        <button class="filter-btn" id="btnApplyPaymentFilters">Filter</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="paymentsTable">
                                <thead>
                                    <tr>
                                        <th>Payment</th>
                                        <th>Order</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Mode</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="paymentsTableBody">
                                    <tr><td colspan="7" class="table-loading">Loading payments...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="paymentsCount" class="table-info">—</div>
                            <div class="pagination" id="paymentsPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- COUPONS VIEW -->
                <div class="view" id="view-coupons">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Coupons</h2>
                            <p class="view-subtitle">Create and manage discount codes</p>
                        </div>
                        <button class="btn-primary btn-add" id="btnAddCoupon">+ Add Coupon</button>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="couponSearch" class="filter-input" placeholder="Search code or description...">
                        <select id="couponFilterStatus" class="filter-select">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                        <button class="filter-btn" id="btnApplyCouponFilters">Filter</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="couponsTable">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Discount</th>
                                        <th>Min Order</th>
                                        <th>Usage</th>
                                        <th>Expires</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="couponsTableBody">
                                    <tr><td colspan="7" class="table-loading">Loading coupons...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="couponsCount" class="table-info">—</div>
                            <div class="pagination" id="couponsPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- INVENTORY VIEW -->
                <div class="view" id="view-inventory">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Inventory</h2>
                            <p class="view-subtitle">Manage stock levels and view history</p>
                        </div>
                        <button class="filter-btn" onclick="window.novaInventory.openHistory()">📜 View History</button>
                    </div>

                    <div class="inv-stats" id="invStats">
                        <div class="inv-stat-card">
                            <div class="inv-stat-label">Total Products</div>
                            <div class="inv-stat-value" id="invStatTotal">0</div>
                        </div>
                        <div class="inv-stat-card green">
                            <div class="inv-stat-label">Total Value</div>
                            <div class="inv-stat-value" id="invStatValue">₹0</div>
                        </div>
                        <div class="inv-stat-card amber">
                            <div class="inv-stat-label">Low Stock (&lt;5)</div>
                            <div class="inv-stat-value" id="invStatLow">0</div>
                        </div>
                        <div class="inv-stat-card red">
                            <div class="inv-stat-label">Out of Stock</div>
                            <div class="inv-stat-value" id="invStatOut">0</div>
                        </div>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="invSearch" class="filter-input" placeholder="Search name or SKU...">
                        <select id="invFilter" class="filter-select">
                            <option value="">All Stock</option>
                            <option value="low">Low Stock</option>
                            <option value="out">Out of Stock</option>
                            <option value="in">In Stock (≥5)</option>
                        </select>
                        <button class="filter-btn" id="btnApplyInvFilters">Filter</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="inventoryTable">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>SKU</th>
                                        <th>Category</th>
                                        <th>Stock</th>
                                        <th>Value</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="inventoryTableBody">
                                    <tr><td colspan="6" class="table-loading">Loading inventory...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="inventoryCount" class="table-info">—</div>
                            <div class="pagination" id="inventoryPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- REVIEWS VIEW -->
                <div class="view" id="view-reviews">
                    <div class="view-header">
                        <div>
                            <h2 class="view-title">Reviews</h2>
                            <p class="view-subtitle">Moderate customer reviews and ratings</p>
                        </div>
                        <button class="filter-btn" onclick="window.novaReviews.refresh()">🔄 Refresh</button>
                    </div>

                    <div class="review-stats" id="reviewStats">
                        <div class="review-stat-card">
                            <div class="review-stat-label">Total</div>
                            <div class="review-stat-value" id="rStatTotal">0</div>
                        </div>
                        <div class="review-stat-card amber">
                            <div class="review-stat-label">Pending</div>
                            <div class="review-stat-value" id="rStatPending">0</div>
                        </div>
                        <div class="review-stat-card green">
                            <div class="review-stat-label">Approved</div>
                            <div class="review-stat-value" id="rStatApproved">0</div>
                        </div>
                        <div class="review-stat-card red">
                            <div class="review-stat-label">Rejected</div>
                            <div class="review-stat-value" id="rStatRejected">0</div>
                        </div>
                        <div class="review-stat-card blue">
                            <div class="review-stat-label">Avg Rating</div>
                            <div class="review-stat-value" id="rStatAvg">0.0</div>
                        </div>
                    </div>

                    <div class="filters-bar">
                        <input type="search" id="reviewSearch" class="filter-input" placeholder="Search name, comment...">
                        <select id="reviewFilterStatus" class="filter-select">
                            <option value="">All Status</option>
                            <option value="pending">Pending</option>
                            <option value="approved">Approved</option>
                            <option value="rejected">Rejected</option>
                        </select>
                        <button class="filter-btn" id="btnApplyReviewFilters">Filter</button>
                    </div>

                    <div class="table-card">
                        <div class="table-wrapper">
                            <table class="data-table" id="reviewsTable">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Product</th>
                                        <th>Rating</th>
                                        <th>Comment</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="reviewsTableBody">
                                    <tr><td colspan="7" class="table-loading">Loading reviews...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-footer">
                            <div id="reviewsCount" class="table-info">—</div>
                            <div class="pagination" id="reviewsPagination"></div>
                        </div>
                    </div>
                </div>

                <!-- SETTINGS VIEW -->
                <div class="view" id="view-settings">
                    <div style="background:var(--navy);border:1px solid var(--navy-light);border-radius:12px;padding:40px;text-align:center;">
                        <h2 style="color:var(--white);font-size:24px;margin-bottom:10px;">Settings</h2>
                        <p style="color:var(--muted);font-size:14px;">Coming in Phase 3N.</p>
                    </div>
                </div>


            <!-- PRODUCT MODAL -->
            <div class="modal-overlay" id="productModal">
                <div class="modal">
                    <div class="modal-header">
                        <h3 id="modalTitle">Add Product</h3>
                        <button class="modal-close" id="modalClose">✕</button>
                    </div>
                    <form id="productForm" class="modal-body">
                        <input type="hidden" id="productId" name="productId">

                        <div class="form-row">
                            <div class="form-group">
                                <label>Product Name *</label>
                                <input type="text" id="pName" name="name" required maxlength="120">
                            </div>
                            <div class="form-group">
                                <label>SKU</label>
                                <input type="text" id="pSku" name="sku" maxlength="40">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Short Description</label>
                            <input type="text" id="pShortDesc" name="shortDescription" maxlength="200">
                        </div>

                        <div class="form-group">
                            <label>Full Description *</label>
                            <textarea id="pDescription" name="description" required rows="4" maxlength="2000"></textarea>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Category</label>
                                <select id="pCategory" name="category">
                                    <option value="">— No category —</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Stock *</label>
                                <input type="number" id="pStock" name="stock" required min="0" step="1">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Original Price (₹) *</label>
                                <input type="number" id="pOriginalPrice" name="originalPrice" required min="0" step="0.01">
                            </div>
                            <div class="form-group">
                                <label>Sale Price (₹) *</label>
                                <input type="number" id="pSalePrice" name="salePrice" required min="0" step="0.01">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Images (max 5, 3MB each)</label>
                            <input type="file" id="pImages" name="images" accept="image/jpeg,image/png,image/webp" multiple>
                            <div id="imagePreview" class="image-preview"></div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Featured Product</label>
                                <select id="pIsFeatured" name="isFeatured">
                                    <option value="false">No</option>
                                    <option value="true">Yes</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <select id="pStatus" name="status">
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" id="modalCancel">Cancel</button>
                            <button type="submit" class="btn-primary" id="modalSave">Save Product</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- DELETE CONFIRM MODAL -->
            <div class="modal-overlay" id="deleteModal">
                <div class="modal" style="max-width:420px;">
                    <div class="modal-header">
                        <h3>Delete Product?</h3>
                    </div>
                    <div class="modal-body" style="text-align:center;">
                        <p style="color:var(--muted);margin-bottom:20px;">Are you sure you want to delete <strong id="deleteProductName" style="color:var(--white);">this product</strong>? This action cannot be undone.</p>
                        <div class="modal-footer" style="justify-content:center;">
                            <button type="button" class="btn-secondary" id="deleteCancel">Cancel</button>
                            <button type="button" class="btn-danger" id="deleteConfirm">Delete</button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- CATEGORY MODAL -->
            <div class="modal-overlay" id="categoryModal">
                <div class="modal" style="max-width:520px;">
                    <div class="modal-header">
                        <h3 id="categoryModalTitle">Add Category</h3>
                        <button class="modal-close" id="categoryModalClose">✕</button>
                    </div>
                    <form id="categoryForm" class="modal-body">
                        <input type="hidden" id="categoryId" name="categoryId">

                        <div class="form-group">
                            <label>Category Name *</label>
                            <input type="text" id="cName" name="name" required maxlength="80" placeholder="e.g. Electronics">
                        </div>

                        <div class="form-group">
                            <label>Description</label>
                            <textarea id="cDescription" name="description" rows="3" maxlength="500" placeholder="Optional description"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Category Image (optional, max 2MB)</label>
                            <input type="file" id="cImage" name="image" accept="image/jpeg,image/png,image/webp">
                            <div id="categoryImagePreview" class="image-preview"></div>
                        </div>

                        <div class="form-group">
                            <label>Status</label>
                            <select id="cStatus" name="status">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" id="categoryModalCancel">Cancel</button>
                            <button type="submit" class="btn-primary" id="categoryModalSave">Save Category</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- DELETE CATEGORY MODAL -->
            <div class="modal-overlay" id="deleteCategoryModal">
                <div class="modal" style="max-width:420px;">
                    <div class="modal-header">
                        <h3>Delete Category?</h3>
                    </div>
                    <div class="modal-body" style="text-align:center;">
                        <p style="color:var(--muted);margin-bottom:20px;">Delete <strong id="deleteCategoryName" style="color:var(--white);">this category</strong>? Products must be reassigned first.</p>
                        <div class="modal-footer" style="justify-content:center;">
                            <button type="button" class="btn-secondary" id="deleteCategoryCancel">Cancel</button>
                            <button type="button" class="btn-danger" id="deleteCategoryConfirm">Delete</button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- ORDER DETAIL MODAL -->
            <div class="modal-overlay" id="orderDetailModal">
                <div class="modal" style="max-width:720px;">
                    <div class="modal-header">
                        <h3 id="orderDetailTitle">Order Details</h3>
                        <button class="modal-close" id="orderDetailClose">✕</button>
                    </div>
                    <div class="modal-body" id="orderDetailBody">
                        <div class="loading-text">Loading...</div>
                    </div>
                </div>
            </div>


            <!-- CUSTOMER DETAIL MODAL -->
            <div class="modal-overlay" id="customerDetailModal">
                <div class="modal" style="max-width:720px;">
                    <div class="modal-header">
                        <h3 id="customerDetailTitle">Customer Details</h3>
                        <button class="modal-close" id="customerDetailClose">✕</button>
                    </div>
                    <div class="modal-body" id="customerDetailBody">
                        <div class="loading-text">Loading...</div>
                    </div>
                </div>
            </div>


            <!-- PAYMENT DETAIL MODAL -->
            <div class="modal-overlay" id="paymentDetailModal">
                <div class="modal" style="max-width:640px;">
                    <div class="modal-header">
                        <h3 id="paymentDetailTitle">Payment Details</h3>
                        <button class="modal-close" id="paymentDetailClose">✕</button>
                    </div>
                    <div class="modal-body" id="paymentDetailBody">
                        <div class="loading-text">Loading...</div>
                    </div>
                </div>
            </div>


            <!-- COUPON MODAL -->
            <div class="modal-overlay" id="couponModal">
                <div class="modal" style="max-width:620px;">
                    <div class="modal-header">
                        <h3 id="couponModalTitle">Add Coupon</h3>
                        <button class="modal-close" id="couponModalClose">✕</button>
                    </div>
                    <form id="couponForm" class="modal-body">
                        <input type="hidden" id="couponId">

                        <div class="form-row">
                            <div class="form-group">
                                <label>Coupon Code *</label>
                                <input type="text" id="cpCode" required maxlength="20" placeholder="e.g. SAVE10" style="text-transform:uppercase;">
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <select id="cpStatus">
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" id="cpDescription" maxlength="200" placeholder="e.g. 10% off on all orders">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Discount Type *</label>
                                <select id="cpDiscountType" required>
                                    <option value="percentage">Percentage (%)</option>
                                    <option value="fixed">Fixed Amount (₹)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Discount Value *</label>
                                <input type="number" id="cpDiscountValue" required min="1" step="0.01">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Min Order Value (₹)</label>
                                <input type="number" id="cpMinOrder" min="0" step="0.01" value="0">
                            </div>
                            <div class="form-group">
                                <label>Max Discount (₹) — for % only</label>
                                <input type="number" id="cpMaxDiscount" min="0" step="0.01" value="0">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Start Date</label>
                                <input type="date" id="cpStartDate">
                            </div>
                            <div class="form-group">
                                <label>Expiry Date *</label>
                                <input type="date" id="cpExpiryDate" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Total Usage Limit (0 = unlimited)</label>
                                <input type="number" id="cpUsageLimit" min="0" value="0">
                            </div>
                            <div class="form-group">
                                <label>Per Customer Limit</label>
                                <input type="number" id="cpPerCustomer" min="1" value="1">
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" id="couponModalCancel">Cancel</button>
                            <button type="submit" class="btn-primary" id="couponModalSave">Save Coupon</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- DELETE COUPON MODAL -->
            <div class="modal-overlay" id="deleteCouponModal">
                <div class="modal" style="max-width:420px;">
                    <div class="modal-header"><h3>Delete Coupon?</h3></div>
                    <div class="modal-body" style="text-align:center;">
                        <p style="color:var(--muted);margin-bottom:20px;">Delete <strong id="deleteCouponCode" style="color:var(--white);">this coupon</strong>? This action cannot be undone.</p>
                        <div class="modal-footer" style="justify-content:center;">
                            <button type="button" class="btn-secondary" id="deleteCouponCancel">Cancel</button>
                            <button type="button" class="btn-danger" id="deleteCouponConfirm">Delete</button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- ADJUST STOCK MODAL -->
            <div class="modal-overlay" id="adjustStockModal">
                <div class="modal" style="max-width:460px;">
                    <div class="modal-header">
                        <h3 id="adjustStockTitle">Adjust Stock</h3>
                        <button class="modal-close" id="adjustStockClose">✕</button>
                    </div>
                    <form id="adjustStockForm" class="modal-body">
                        <input type="hidden" id="adjustProductId">
                        <div class="form-group">
                            <label>Product</label>
                            <div id="adjustProductName" style="color:var(--white);font-weight:600;padding:10px 12px;background:var(--navy-deep);border-radius:8px;font-size:13px;">—</div>
                        </div>
                        <div class="form-group">
                            <label>Current Stock</label>
                            <div id="adjustCurrentStock" style="color:var(--blue-bright);font-weight:700;font-size:20px;padding:4px 0;">—</div>
                        </div>
                        <div class="form-group">
                            <label>Change (positive = add, negative = remove)</label>
                            <input type="number" id="adjustChange" required step="1" placeholder="e.g. 10 or -5">
                        </div>
                        <div class="form-group">
                            <label>Reason</label>
                            <select id="adjustReason">
                                <option value="restock">Restock (new stock arrived)</option>
                                <option value="manual_adjust">Manual correction</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Note (optional)</label>
                            <input type="text" id="adjustNote" maxlength="200" placeholder="e.g. Supplier delivery #123">
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" id="adjustStockCancel">Cancel</button>
                            <button type="submit" class="btn-primary" id="adjustStockSave">Adjust</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- STOCK HISTORY MODAL -->
            <div class="modal-overlay" id="stockHistoryModal">
                <div class="modal" style="max-width:720px;">
                    <div class="modal-header">
                        <h3>Stock History</h3>
                        <button class="modal-close" id="stockHistoryClose">✕</button>
                    </div>
                    <div class="modal-body" id="stockHistoryBody">
                        <div class="loading-text">Loading...</div>
                    </div>
                </div>
            </div>


            <!-- REJECT REVIEW MODAL -->
            <div class="modal-overlay" id="rejectReviewModal">
                <div class="modal" style="max-width:420px;">
                    <div class="modal-header"><h3>Reject Review?</h3></div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label>Reason (optional)</label>
                            <textarea id="rejectReason" rows="3" placeholder="e.g. Spam / inappropriate content" style="width:100%;padding:10px;background:var(--navy-deep);border:1px solid var(--navy-light);border-radius:8px;color:white;font-family:inherit;"></textarea>
                        </div>
                        <div class="modal-footer" style="justify-content:center;">
                            <button type="button" class="btn-secondary" id="rejectReviewCancel">Cancel</button>
                            <button type="button" class="btn-danger" id="rejectReviewConfirm">Reject</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DELETE REVIEW MODAL -->
            <div class="modal-overlay" id="deleteReviewModal">
                <div class="modal" style="max-width:420px;">
                    <div class="modal-header"><h3>Delete Review?</h3></div>
                    <div class="modal-body" style="text-align:center;">
                        <p style="color:var(--muted);margin-bottom:20px;">This will permanently delete this review. Product rating will be recalculated.</p>
                        <div class="modal-footer" style="justify-content:center;">
                            <button type="button" class="btn-secondary" id="deleteReviewCancel">Cancel</button>
                            <button type="button" class="btn-danger" id="deleteReviewConfirm">Delete</button>
                        </div>
                    </div>
                </div>
            </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="/admin/js/auth.js"></script>
    <script src="/admin/js/app.js"></script>
    <script src="/admin/js/views/dashboard.js"></script>
    <script src="/admin/js/views/products.js"></script>
    <script src="/admin/js/views/categories.js"></script>
    <script src="/admin/js/views/orders.js"></script>
    <script src="/admin/js/views/customers.js"></script>
    <script src="/admin/js/views/payments.js"></script>
    <script src="/admin/js/views/coupons.js"></script>
    <script src="/admin/js/views/inventory.js"></script>
    <script src="/admin/js/views/reviews.js"></script>
    <script src="/admin/js/views/settings.js"></script>
    <script src="/admin/js/views/notifications.js"></script>
</body>
</html>
